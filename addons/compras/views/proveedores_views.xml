<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_proveedor_tree" model="ir.ui.view">
        <field name="name">iv.proveedor.tree</field>
        <field name="model">iv.proveedor</field>
        <field name="arch" type="xml">
            <tree string="Proveedores">
                <field name="nombre"/>
                <field name="telefono"/>
                <field name="correo"/>
                <field name="direccion"/>
            </tree>
        </field>
    </record>

    <record id="view_proveedor_form" model="ir.ui.view">
        <field name="name">iv.proveedor.form</field>
        <field name="model">iv.proveedor</field>
        <field name="arch" type="xml">
            <form string="Proveedor">
                <sheet>
                    <group>
                        <group>
                            <field name="nombre"/>
                            <field name="telefono"/>
                        </group>
                        <group>
                            <field name="correo"/>
                            <field name="direccion"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Productos">
                            <field name="producto_ids">
                                <tree>
                                    <field name="codigo"/>
                                    <field name="nombre"/>
                                    <field name="stock"/>
                                    <field name="precio_venta"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Compras">
                            <field name="compra_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="fecha"/>
                                    <field name="total"/>
                                    <field name="estado"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_proveedores" model="ir.actions.act_window">
        <field name="name">Proveedores</field>
        <field name="res_model">iv.proveedor</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
